/**
 * ⚠️ CONFIGURACIÓN DE ESTA INSTALACIÓN.
 *
 * Copiá este archivo a `site.ts` y ajustalo a tu cluster:
 *
 *   cp site.ts.example site.ts
 *
 * `site.ts` no se commitea (está en .gitignore) — es configuración de esta
 * instalación, no del proyecto. Junto con `ownership/active.ts` y
 * `ownership/port.ts` (si lo usás), es todo lo que depende de tu
 * organización.
 */

import type { ExtraFilter } from "./extraFilters";
import type { PriceBase } from "./listPrices";

// ── Namespaces excluidos ─────────────────────────────────────────────────────

/**
 * Namespaces que no son carga de negocio y por tanto no deben generar
 * hallazgos: plataforma de Kubernetes, agentes de observabilidad, ingress,
 * herramientas de seguridad propias, etc.
 *
 * Vive en un solo sitio para que todos los módulos excluyan exactamente lo
 * mismo. Estos son solo los que crea Kubernetes por defecto — agregá los de
 * tu cluster (tu propio namespace de plataforma, tu ingress, tu agente de
 * seguridad…).
 */
export const EXCLUDED_NAMESPACES_EXACT: string[] = [
  "kube-system",
  "kube-public",
  "kube-node-lease",
  "default",
];

/**
 * Además de la lista exacta, se descarta cualquier namespace cuyo nombre
 * **contenga** alguno de estos fragmentos. Vacío a propósito: un fragmento
 * como "system" también descarta un namespace de equipo como
 * "payment-system", y lo hace en todos los módulos sin avisar. Preferí
 * nombres exactos; la pestaña Setup marca lo que cae solo por un fragmento.
 */
export const EXCLUDED_NAMESPACES_CONTAINING: string[] = [];

// ── Modelo de costos (FinOps) ────────────────────────────────────────────────

/**
 * Precio unitario mensual de cómputo, para valorizar el desperdicio. Orden
 * de magnitud razonable en cualquier cluster; para cifras defendibles poné
 * las de tu contrato (con reserved instances o un Enterprise Agreement el
 * costo real suele ser 20-40 % menor que precio de lista).
 */
export const USD_VCPU_MONTH = 17.52;
export const USD_GB_MONTH = 4.38;

/** Horas facturables que se consideran un mes. */
export const HOURS_PER_MONTH = 730;

/**
 * Base de precios de lista: "azure", "aws", "gcp" o "none".
 *
 * Con una nube elegida, cada nodo toma el precio de lista on-demand (Linux)
 * de su tipo de instancia, de una región de referencia por nube. La tabla
 * está en `listPrices.ts` y la genera `tools/list-prices/update.mjs` desde
 * las fuentes públicas de cada nube. Es un techo: con reservas o un acuerdo
 * empresarial se paga menos. Setup sugiere la base según tus nodos.
 *
 * "none" para clusters on-premise o si solo quieres tus propios precios.
 */
export const PRICE_BASE: PriceBase = "none";

/**
 * Tus propios precios por hora, por tipo de instancia. Ganan siempre sobre la
 * base de lista: úsalos para un precio de contrato, otra región, nodos
 * Windows, on-premise o un tipo que la lista no tiene. Los tipos sin precio en
 * ninguna de las dos capas quedan sin gasto, en vez de asumir uno equivocado.
 *
 * Ejemplo de formato (Azure):
 *
 *   Standard_D4s_v4: 0.192,
 */
export const INSTANCE_HOURLY_USD: Record<string, number> = {};

/** De dónde salen tus propios precios, para mostrarlo junto a las cifras. */
export const PRICING_SOURCE = "Own prices";

// -- Claves de propiedad en labels/annotations ------------------------------

/**
 * Que clave de label/annotation lleva cada dato de propiedad.
 *
 * Es lo primero que hay que ajustar si usas `labelsProvider`: casi ninguna
 * organizacion usa las claves del ejemplo, y apuntar a las que YA existen
 * cuesta una linea, mientras que reetiquetar mil workloads cuesta un trimestre.
 *
 * Para ver que hay en tu cluster:
 *
 *   smartscapeNodes K8S_DEPLOYMENT, K8S_STATEFULSET
 *   | fields k8s.workload.name, lbl = `tags:k8s.labels`
 *   | limit 5
 *
 * Las annotations ganan sobre las labels: las labels de un pod template son
 * inmutables en algunos controladores y las annotations no, asi que son la via
 * para sobrescribir un workload puntual.
 */
export const OWNERSHIP_KEYS = {
  tier: "archorkube.io/tier",
  squad: "archorkube.io/owner",
  tribu: "archorkube.io/domain",
  appCode: "app.kubernetes.io/part-of",
} as const;

/**
 * Valores de label que significan "sin asignar" y NO deben pasar por dueño.
 *
 * Un string vacio no es null en DQL, asi que sin esta lista `coalesce` lo toma
 * como respuesta valida y el workload aparece con dueno "" — peor que aparecer
 * sin dueno, porque el hueco deja de verse y nadie lo corrige.
 *
 * Lo mismo con los marcadores que los equipos ponen mientras deciden
 * ("pendiente", "tbd", "n/a"). Se comparan en minusculas.
 */
export const OWNERSHIP_IGNORED_VALUES: string[] = [
  "",
  // El catalogo puede traer el string "None" como "sin asignar".
  "none",
  "n/a",
  "na",
  "tbd",
  "pendiente",
  "unknown",
  "sin asignar",
];

// ── Filtros opcionales ───────────────────────────────────────────────────────

/**
 * Labels o annotations de tus workloads que quieres como filtro extra, además
 * de cluster, namespace, tier, tribu y squad. Por ejemplo una criticidad de
 * negocio, un centro de costo o un producto.
 *
 * Cada una aparece como selector solo si la clave existe en tu tenant; si no,
 * el filtro se esconde. La pestaña Setup muestra qué claves tienen tus
 * workloads y cuántos las llevan.
 *
 * La label puede estar en el workload (por defecto) o en su namespace
 * (`scope: "namespace"`), que es donde suele declararse un centro de costo.
 * Cada filtro también aparece como eje en las gráficas ("Agrupar por").
 *
 *   export const EXTRA_FILTERS: ExtraFilter[] = [
 *     { id: "criticality", label: "Business criticality", key: "business-criticality" },
 *     // La etiqueta también puede ir en los dos idiomas de la app:
 *     {
 *       id: "costcenter",
 *       label: { en: "Cost center", es: "Centro de costo" },
 *       key: "cost-center",
 *       scope: "namespace",
 *     },
 *   ];
 */

export const EXTRA_FILTERS: ExtraFilter[] = [];
