# Environment de Dynatrace contra el que corre `dt-app dev|build|deploy`.
# Copia este archivo a `.env` y pon la URL de TU tenant:
#
#   cp .env.example .env
#
# Se lee automaticamente. `app.config.json` ya no lleva la URL, para que el
# repo se pueda compartir sin revelar a que environment pertenece.
DT_APP_ENVIRONMENT_URL=https://<tu-tenant>.apps.dynatrace.com/
