# Dynatrace environment that `dt-app dev|build|deploy` runs against.
# Copy this file to `.env` and set YOUR tenant URL:
#
#   cp .env.example .env
#
# It's read automatically. `app.config.json` doesn't carry the URL, so the
# repo can be shared without revealing which environment it belongs to.
DT_APP_ENVIRONMENT_URL=https://<your-tenant>.apps.dynatrace.com/
